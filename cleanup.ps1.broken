# AWS Serverless SaaS Demo - Cleanup Script
# This script deletes all AWS resources created by the demo deployment
# WARNING: This will permanently delete all resources and data!

Write-Host ""
Write-Host "========================================" -ForegroundColor Red
Write-Host " AWS SERVERLESS SAAS DEMO - CLEANUP" -ForegroundColor Red
Write-Host "========================================" -ForegroundColor Red
Write-Host ""
Write-Host "This will DELETE ALL AWS resources created by the demo!" -ForegroundColor Yellow
Write-Host "Including:" -ForegroundColor Yellow
Write-Host "  • CloudFormation stacks" -ForegroundColor Yellow
Write-Host "  • S3 buckets and all files" -ForegroundColor Yellow
Write-Host "  • Lambda functions" -ForegroundColor Yellow
Write-Host "  • API Gateways" -ForegroundColor Yellow
Write-Host "  • Cognito User Pools" -ForegroundColor Yellow
Write-Host "  • CloudWatch Log Groups" -ForegroundColor Yellow
Write-Host "  • DynamoDB tables" -ForegroundColor Yellow
Write-Host "  • CloudFront distributions (takes 20-35 minutes)" -ForegroundColor Yellow
Write-Host ""
$confirmation = Read-Host "Are you ABSOLUTELY sure? Type 'DELETE' to proceed"

if ($confirmation -ne 'DELETE') {
    Write-Host ""
    Write-Host "Cleanup cancelled." -ForegroundColor Green
    Write-Host ""
    exit 0
}

Write-Host ""
Write-Host "Starting cleanup process..." -ForegroundColor Cyan
Write-Host ""

# Load configuration
$configFile = ".\deployment-config.json"
if (-not (Test-Path $configFile)) {
    Write-Host "Error: Configuration file not found: $configFile" -ForegroundColor Red
    Write-Host "Please ensure you are in the DEMO directory and have run the deployment scripts first." -ForegroundColor Red
    exit 1
}

$config = Get-Content $configFile -Raw | ConvertFrom-Json
$env:AWS_REGION = $config.AWS_REGION
$env:AWS_PROFILE = $config.AWS_PROFILE
$env:DEMO_STACK_PREFIX = $config.DEMO_STACK_PREFIX

Write-Host "Configuration loaded:" -ForegroundColor Cyan
Write-Host "  AWS Region: $env:AWS_REGION" -ForegroundColor Gray
Write-Host "  AWS Profile: $env:AWS_PROFILE" -ForegroundColor Gray
Write-Host "  Stack Prefix: $env:DEMO_STACK_PREFIX" -ForegroundColor Gray
Write-Host ""

# Step 1: Delete Tenant Stack (if exists)
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 1: Deleting Tenant Stack" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$tenantStackName = "$env:DEMO_STACK_PREFIX-tenant"
$tenantStackExists = aws cloudformation describe-stacks --stack-name $tenantStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null

if ($tenantStackExists) {
    Write-Host "  Deleting stack: $tenantStackName" -ForegroundColor Yellow
    aws cloudformation delete-stack --stack-name $tenantStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION
    
    Write-Host "  Waiting for stack deletion to complete..." -ForegroundColor Yellow
    Write-Host "  (This may take 20-35 minutes due to CloudFront distribution deletion)" -ForegroundColor Gray
    
    aws cloudformation wait stack-delete-complete --stack-name $tenantStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION
    
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  ✓ Tenant stack deleted successfully" -ForegroundColor Green
    } else {
        Write-Host "  ⚠ Tenant stack deletion failed or stack does not exist" -ForegroundColor Yellow
    }
} else {
    Write-Host "  ⊘ Tenant stack not found, skipping" -ForegroundColor Gray
}

Write-Host ""

# Step 2: Delete S3 Buckets for Client Apps (from Tenant Stack)
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 2: Emptying S3 Buckets (Tenant)" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$tenantBuckets = @(
    "application-site-bucket",
    "admin-site-bucket",
    "landing-site-bucket"
)

foreach ($bucketKey in $tenantBuckets) {
    $bucketName = $null
    
    # Try to get bucket name from CloudFormation outputs
    $stackJson = aws cloudformation describe-stacks --stack-name $tenantStackName --output json --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
    
    if ($stackJson) {
        $stack = $stackJson | ConvertFrom-Json
        $stackOutput = $stack.Stacks[0].Outputs | Where-Object { $_.OutputKey -eq $bucketKey } | Select-Object -ExpandProperty OutputValue -First 1
        $bucketName = $stackOutput
    }
    
    if (-not $bucketName) {
        # Try to find bucket by prefix using PowerShell filtering
        $bucketPrefix = "$env:DEMO_STACK_PREFIX-"
        $allBucketsJson = aws s3api list-buckets --output json --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
        
        if ($allBucketsJson) {
            $allBuckets = ($allBucketsJson | ConvertFrom-Json).Buckets | Where-Object { $_.Name -like "$bucketPrefix*" } | Select-Object -ExpandProperty Name
            $matchingBucket = $allBuckets | Where-Object { $_ -match $bucketKey.Replace("-bucket", "") } | Select-Object -First 1
            if ($matchingBucket) {
                $bucketName = $matchingBucket
            }
        }
    }
    
    if ($bucketName) {
        Write-Host "  Emptying bucket: $bucketName" -ForegroundColor Yellow
        
        try {
            aws s3 rm "s3://$bucketName" --recursive --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            Write-Host "  ✓ Bucket emptied: $bucketName" -ForegroundColor Green
        } catch {
            Write-Host "  ⚠ Could not empty bucket: $bucketName" -ForegroundColor Yellow
        }
    } else {
        Write-Host "  ⊘ Bucket not found: $bucketKey" -ForegroundColor Gray
    }
}

Write-Host ""

# Step 3: Delete Shared Stack
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 3: Deleting Shared Stack" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$sharedStackName = "$env:DEMO_STACK_PREFIX-shared"
$sharedStackExists = aws cloudformation describe-stacks --stack-name $sharedStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null

if ($sharedStackExists) {
    Write-Host "  Deleting stack: $sharedStackName" -ForegroundColor Yellow
    aws cloudformation delete-stack --stack-name $sharedStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION
    
    Write-Host "  Waiting for stack deletion to complete..." -ForegroundColor Yellow
    aws cloudformation wait stack-delete-complete --stack-name $sharedStackName --profile $env:AWS_PROFILE --region $env:AWS_REGION
    
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  ✓ Shared stack deleted successfully" -ForegroundColor Green
    } else {
        Write-Host "  ⚠ Shared stack deletion failed or stack does not exist" -ForegroundColor Yellow
    }
} else {
    Write-Host "  ⊘ Shared stack not found, skipping" -ForegroundColor Gray
}

Write-Host ""

# Step 4: Delete SAM Deployment Bucket
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 4: Deleting SAM Deployment Bucket" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$samBucketPrefix = "$env:DEMO_STACK_PREFIX-sam-artifacts"
$samBucketsJson = aws s3api list-buckets --output json --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null

if ($samBucketsJson) {
    $samBuckets = ($samBucketsJson | ConvertFrom-Json).Buckets | Where-Object { $_.Name -like "$samBucketPrefix*" } | Select-Object -ExpandProperty Name
    
    foreach ($bucket in $samBuckets) {
        if ($bucket) {
            Write-Host "  Deleting SAM bucket: $bucket" -ForegroundColor Yellow
            
            # Empty the bucket first
            aws s3 rm "s3://$bucket" --recursive --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            
            # Delete the bucket
            aws s3api delete-bucket --bucket $bucket --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            
            Write-Host "  ✓ Deleted SAM bucket: $bucket" -ForegroundColor Green
        }
    }
} else {
    Write-Host "  ⊘ No SAM buckets found" -ForegroundColor Gray
}

Write-Host ""

# Step 5: Delete remaining S3 buckets with stack prefix
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 5: Deleting Other S3 Buckets" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$allBucketsJson = aws s3api list-buckets --output json --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null

if ($allBucketsJson) {
    $allBuckets = ($allBucketsJson | ConvertFrom-Json).Buckets | Where-Object { $_.Name -like "$env:DEMO_STACK_PREFIX*" } | Select-Object -ExpandProperty Name
    
    foreach ($bucket in $allBuckets) {
        if ($bucket) {
            Write-Host "  Deleting bucket: $bucket" -ForegroundColor Yellow
            
            # Empty and delete
            aws s3 rm "s3://$bucket" --recursive --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            aws s3api delete-bucket --bucket $bucket --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            
            Write-Host "  ✓ Deleted bucket: $bucket" -ForegroundColor Green
        }
    }
} else {
    Write-Host "  ⊘ No additional buckets found" -ForegroundColor Gray
}

Write-Host ""

# Step 6: Delete CloudWatch Log Groups
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Step 6: Deleting CloudWatch Log Groups" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

$deleteLogsConfirmation = Read-Host "Delete CloudWatch Log Groups? (y/N)"

if ($deleteLogsConfirmation -eq 'y' -or $deleteLogsConfirmation -eq 'Y') {
    Write-Host "  Searching for log groups..." -ForegroundColor Yellow
    
    try {
        $logPrefix = "/aws/lambda/$env:DEMO_STACK_PREFIX"
        $logGroups = aws logs describe-log-groups --output json --profile $env:AWS_PROFILE --region $env:AWS_REGION | ConvertFrom-Json | Select-Object -ExpandProperty logGroups | Where-Object { $_.logGroupName -like "$logPrefix*" } | Select-Object -ExpandProperty logGroupName
        
        foreach ($logGroup in $logGroups) {
            Write-Host "  Deleting log group: $logGroup" -ForegroundColor Yellow
            aws logs delete-log-group --log-group-name $logGroup --profile $env:AWS_PROFILE --region $env:AWS_REGION 2>$null
            Write-Host "  ✓ Deleted log group: $logGroup" -ForegroundColor Green
        }
    } catch {
        Write-Host "  ⚠ Could not delete log groups" -ForegroundColor Yellow
    }
} else {
    Write-Host "  ⊘ Skipped log group deletion" -ForegroundColor Gray
}

Write-Host ""
Write-Host "========================================" -ForegroundColor Green
Write-Host " ✓ Cleanup Completed!" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green
Write-Host ""
Write-Host "All AWS resources have been deleted." -ForegroundColor Gray
Write-Host "You can verify by checking the AWS Console:" -ForegroundColor Gray
Write-Host "  • CloudFormation: https://console.aws.amazon.com/cloudformation" -ForegroundColor Gray
Write-Host "  • S3: https://console.aws.amazon.com/s3" -ForegroundColor Gray
Write-Host ""
